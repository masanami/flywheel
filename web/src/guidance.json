{
  "outside_note": "本人確認が要る操作です。Claude Code の外のターミナルで実行してください（この画面からは行えません）。",
  "conversation_note": "Claude Code との対話で伝えれば、LLM が記録します（ターミナルのコマンドの代わりに使えます）。",
  "completion_button_note": "このボタンは、完了を記録するだけです。反映先へ入れる承認は、対話で行います。",
  "completion_release_note": "反映先へ入れるところまで承認するときは、Claude Code との対話で、この課題の反映まで承認すると伝えてください。",
  "completion_reject_note": "差し戻すときは、Claude Code との対話で、差し戻す旨と理由を伝えてください。",
  "cycle_start_notes": {
    "started": "サイクルを始めました。",
    "already_running": "走っているサイクルが、続きを進めます。",
    "no_work": "いま進められるものが無いので、サイクルは始めていません。",
    "disabled": "サイクルを自動で始めない設定です。",
    "unavailable": "サイクルを始められませんでした。サイクルの画面の「サイクルを回す」から始められます。"
  },
  "completion_approved_note": "完了の承認を記録しました。反映先へ入れる承認は、Claude Code との対話で行います。",
  "conversation_actions": [
    "approve_plan",
    "approve_completion",
    "answer_question",
    "approve_operation",
    "increase_budget"
  ],
  "templates": [
    {
      "id": "reject",
      "when": { "actions": ["approve_plan", "approve_completion"] },
      "command": ["reject"],
      "flags": ["workspace", "reason"],
      "template": "flywheel reject <C-ID> --workspace <パス> --reason <理由>"
    },
    {
      "id": "approve-with-release",
      "when": { "actions": ["approve_completion"] },
      "command": ["approve"],
      "flags": ["workspace"],
      "template": "flywheel approve <C-ID> --workspace <パス>",
      "note": "本番反映（release）も同時に承認します"
    },
    {
      "id": "answer",
      "when": { "actions": ["answer_question"], "needs_hold": false },
      "command": ["answer"],
      "flags": ["workspace", "answer"],
      "template": "flywheel answer <C-ID> --workspace <パス> --answer <回答>"
    },
    {
      "id": "answer-hold",
      "when": { "actions": ["answer_question"], "needs_hold": true },
      "command": ["answer"],
      "flags": ["workspace", "hold", "answer"],
      "template": "flywheel answer <C-ID> --workspace <パス> --hold <H-ID> --answer <回答>"
    },
    {
      "id": "answer-choice",
      "when": { "context": "plan_approval" },
      "command": ["answer"],
      "flags": ["workspace", "choice"],
      "template": "flywheel answer <C-ID> --workspace <パス> --choice <問いの番号>=<選択肢の番号>"
    },
    {
      "id": "approve-operation",
      "when": { "actions": ["approve_operation"] },
      "command": ["approve"],
      "flags": ["workspace"],
      "template": "flywheel approve <OP-ID> --workspace <パス>"
    },
    {
      "id": "budget",
      "when": { "actions": ["increase_budget"] },
      "command": ["budget"],
      "flags": ["workspace", "impl-usd"],
      "template": "flywheel budget <C-ID> --workspace <パス> --impl-usd <額>"
    },
    {
      "id": "ingest",
      "when": { "context": "ingest" },
      "command": ["ingest"],
      "flags": ["workspace"],
      "template": "flywheel ingest <external_key> --workspace <パス>"
    },
    {
      "id": "cycle",
      "when": { "context": "cycle" },
      "command": ["cycle"],
      "flags": ["workspace"],
      "template": "flywheel cycle --workspace <パス>"
    },
    {
      "id": "slot-clear",
      "when": { "context": "slot" },
      "command": ["slot", "clear"],
      "flags": ["workspace"],
      "template": "flywheel slot clear <SLOT-ID> --workspace <パス>"
    },
    {
      "id": "followup-done",
      "when": { "context": "followups" },
      "command": ["followup", "done"],
      "flags": ["workspace", "note"],
      "template": "flywheel followup done <F-ID> --workspace <パス> --note <確かめた結果>",
      "note": "済みにします（確かめた結果を書きます）"
    },
    {
      "id": "followup-drop",
      "when": { "context": "followups" },
      "command": ["followup", "drop"],
      "flags": ["workspace", "reason"],
      "template": "flywheel followup drop <F-ID> --workspace <パス> --reason <理由>",
      "note": "捨てます（本人確認が要ります）"
    },
    {
      "id": "followup-promote",
      "when": { "context": "followups" },
      "command": ["followup", "promote"],
      "flags": ["workspace"],
      "template": "flywheel followup promote <F-ID> --workspace <パス>",
      "note": "課題に上げます（1 回に 1 件。本人確認が要ります）"
    }
  ]
}
